# Discord Bot
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# MongoDB Atlas — get your free cluster at mongodb.com/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/solitude?retryWrites=true&w=majority

# Fortnite API — get your key at dash.fortnite-api.com
FORTNITE_API_KEY=your_fortnite_api_key_here
